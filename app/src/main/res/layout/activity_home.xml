<?xml version="1.0" encoding="utf-8"?>
<!--
  Three-column landscape cockpit:

    LEFT                      CENTER                       RIGHT
    [1] clock & calendar      [3] circular moving map      [5] phone projection
    [2] FM/AM radio tuner     [4] speed HUD (in the map)   [6] navigation + music
    [7] app dock + all apps                                [8] theme / vehicle / updater

  The map portal is a circle sized by the screen height (dimensionRatio W,1:1); the side
  columns take whatever width is left. The app drawer is a full-screen overlay in this same
  layout rather than a fragment or second activity: opening it is a visibility flip with no
  transaction, no window animation and no risk of the home task stacking.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cockpit_bg">

    <!-- ========================= [3] MAP PORTAL ========================= -->
    <include
        android:id="@+id/mapPortal"
        layout="@layout/widget_map"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/screen_padding"
        android:layout_marginBottom="@dimen/screen_padding"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="W,1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- =========================== LEFT COLUMN =========================== -->
    <LinearLayout
        android:id="@+id/leftColumn"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="@dimen/screen_padding"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/mapPortal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- [1] Clock & calendar. TextClock ticks itself from the system time broadcasts
             (once a second only because the seconds field asks for it). Tap opens alarms. -->
        <include
            android:id="@+id/gaugeClock"
            layout="@layout/widget_clock"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="@dimen/gap" />

        <!-- [2] FM/AM radio tuner -->
        <include
            android:id="@+id/radioCard"
            layout="@layout/widget_radio"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1.35" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="@dimen/gap" />

        <!-- [7] App dock + All Apps -->
        <include
            android:id="@+id/dockStrip"
            layout="@layout/view_dock"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dock_height" />
    </LinearLayout>

    <!-- =========================== RIGHT COLUMN ========================== -->
    <LinearLayout
        android:id="@+id/rightColumn"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="@dimen/screen_padding"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/mapPortal"
        app:layout_constraintTop_toTopOf="parent">

        <!-- [5] Phone projection -->
        <include
            android:id="@+id/cardProjection"
            layout="@layout/widget_projection"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="@dimen/gap" />

        <!-- [6] Navigation + music -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <include
                android:id="@+id/cardNav"
                layout="@layout/widget_navigation"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <Space
                android:layout_width="@dimen/gap"
                android:layout_height="match_parent" />

            <include
                android:id="@+id/cardMusic"
                layout="@layout/widget_music"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />
        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="@dimen/gap" />

        <!-- [8] System controls: theme, vehicle settings, updater -->
        <LinearLayout
            android:id="@+id/systemDock"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dock_height"
            android:background="@drawable/bg_dock"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <ImageButton
                android:id="@+id/btnTheme"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_dock_item"
                android:contentDescription="@string/dock_theme"
                android:padding="14dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_theme" />

            <ImageButton
                android:id="@+id/btnSettings"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_dock_item"
                android:contentDescription="@string/dock_settings"
                android:padding="14dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_settings" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <ImageButton
                    android:id="@+id/btnAbout"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_dock_item"
                    android:contentDescription="@string/dock_updates"
                    android:padding="14dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_update" />

                <View
                    android:id="@+id/updateBadge"
                    android:layout_width="@dimen/badge_size"
                    android:layout_height="@dimen/badge_size"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="14dp"
                    android:layout_marginEnd="14dp"
                    android:background="@drawable/badge_dot"
                    android:contentDescription="@string/update_available_badge"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- =========================== MAP SEARCH ============================ -->
    <!-- Full-screen like the app drawer, with the same search field and card styling. -->
    <include
        android:id="@+id/searchPanel"
        layout="@layout/panel_map_search"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- ============================== DRAWER ============================== -->
    <!-- Full screen and last in the file, so it draws above the map. -->
    <LinearLayout
        android:id="@+id/drawerContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/cockpit_scrim"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:padding="@dimen/screen_padding"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_search"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_search" />

                <EditText
                    android:id="@+id/searchInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:autofillHints=""
                    android:background="@null"
                    android:hint="@string/search_apps"
                    android:imeOptions="actionSearch|flagNoExtractUi"
                    android:inputType="text"
                    android:maxLines="1"
                    android:minHeight="56dp"
                    android:singleLine="true"
                    android:textColor="@color/cockpit_text_primary"
                    android:textColorHint="@color/cockpit_text_dim"
                    android:textSize="@dimen/search_text" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnCloseDrawer"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_dock_item"
                android:contentDescription="@string/close_drawer"
                android:src="@drawable/ic_close" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/appGrid"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingBottom="8dp"
                android:scrollbars="vertical" />

            <TextView
                android:id="@+id/drawerEmpty"
                style="@style/Text.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="@string/loading_apps"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
