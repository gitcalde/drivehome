<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cockpit_bg">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:padding="@dimen/screen_padding"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginBottom="@dimen/gap">
            <include
                layout="@layout/drivehome_wordmark"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/dashboardGrid"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <include
                android:id="@+id/mapPortal"
                layout="@layout/widget_map"
                android:layout_width="0dp"
                android:layout_height="0dp" />
            <include
                android:id="@+id/gaugeClock"
                layout="@layout/widget_clock"
                android:layout_width="0dp"
                android:layout_height="0dp" />
            <include
                android:id="@+id/radioCard"
                layout="@layout/widget_radio"
                android:layout_width="0dp"
                android:layout_height="0dp" />
            <include
                android:id="@+id/cardProjection"
                layout="@layout/widget_projection"
                android:layout_width="0dp"
                android:layout_height="0dp" />
            <include
                android:id="@+id/cardNav"
                layout="@layout/widget_navigation"
                android:layout_width="0dp"
                android:layout_height="0dp" />
            <include
                android:id="@+id/cardMusic"
                layout="@layout/widget_music"
                android:layout_width="0dp"
                android:layout_height="0dp" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Fixed controls are never part of the optional widget grid. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/dock_height"
            android:layout_marginTop="@dimen/gap"
            android:orientation="horizontal">

            <include
                android:id="@+id/dockStrip"
                layout="@layout/view_dock"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="5" />

            <Space
                android:layout_width="@dimen/gap"
                android:layout_height="match_parent" />

            <include
                android:id="@+id/systemDock"
                layout="@layout/view_system_dock"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="3" />
        </LinearLayout>
    </LinearLayout>

    <!-- =========================== MAP SEARCH ============================ -->
    <!-- Full-screen like the app drawer, with the same search field and card styling. -->
    <include
        android:id="@+id/searchPanel"
        layout="@layout/panel_map_search"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- ============================== DRAWER ============================== -->
    <!-- Full screen and last in the file, so it draws above the map. -->
    <include
        android:id="@+id/drawerContainer"
        layout="@layout/panel_app_drawer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
