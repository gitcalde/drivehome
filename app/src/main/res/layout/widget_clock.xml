<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/gaugeClock"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:background="@drawable/bg_gauge"
    android:clickable="true"
    android:contentDescription="@string/clock_open"
    android:focusable="true"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="@dimen/tile_padding">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:baselineAligned="true"
        android:orientation="horizontal">

        <TextClock
            android:id="@+id/clockTime"
            style="@style/Text.Gauge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format12Hour="h:mm"
            android:format24Hour="HH:mm"
            android:fontFamily="sans-serif-black"
            android:textSize="@dimen/dashboard_clock_text"
            tools:text="12:47" />

        <TextClock
            android:id="@+id/clockSeconds"
            style="@style/Text.Gauge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:format12Hour="ss"
            android:format24Hour="ss"
            android:textColor="@color/cockpit_accent"
            android:textSize="@dimen/clock_seconds_text"
            tools:text="09" />
    </LinearLayout>

    <TextClock
        android:id="@+id/clockDay"
        style="@style/Text.Caption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:format12Hour="EEEE"
        android:format24Hour="EEEE"
        android:letterSpacing="0.10"
        android:textColor="@color/cockpit_accent"
        android:textSize="@dimen/date_text"
        tools:text="TUESDAY" />

    <TextClock
        android:id="@+id/clockDate"
        style="@style/Text.Caption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:format12Hour="d MMMM yyyy"
        android:format24Hour="d MMMM yyyy"
        android:layout_marginTop="4dp"
        android:letterSpacing="0.02"
        android:textAllCaps="false"
        android:textSize="@dimen/date_text"
        tools:text="16 September 2026" />
</LinearLayout>
