<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@color/drivehome_brand_graphite"
    android:padding="8dp"
    android:contentDescription="@string/app_name">
    <ImageView
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/ic_launcher_foreground"
        android:importantForAccessibility="no" />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif"
        android:textStyle="bold"
        android:textSize="24sp"
        android:text="@string/drivehome_wordmark_drive"
        android:textColor="@color/drivehome_brand_white"
        android:importantForAccessibility="no" />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif"
        android:textStyle="bold"
        android:textSize="24sp"
        android:text="@string/drivehome_wordmark_home"
        android:textColor="@color/drivehome_brand_blue"
        android:importantForAccessibility="no" />
</LinearLayout>
