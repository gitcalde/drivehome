<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="16dp">
        <TextView android:id="@+id/editorPreview" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:gravity="center" android:textSize="18sp"
            android:padding="8dp" android:background="@drawable/bg_map_surface"/>
        <TextView android:id="@+id/editorStatus" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:paddingTop="8dp"/>
        <Spinner android:id="@+id/editorWidget" android:layout_width="match_parent"
            android:layout_height="48dp"/>
        <CheckBox android:id="@+id/editorVisible" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minHeight="48dp"
            android:text="@string/editor_visible"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/editor_column"/>
                <Spinner android:id="@+id/editorColumn" android:layout_width="match_parent"
                    android:layout_height="48dp" android:contentDescription="@string/editor_column"/>
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/editor_row"/>
                <Spinner android:id="@+id/editorRow" android:layout_width="match_parent"
                    android:layout_height="48dp" android:contentDescription="@string/editor_row"/>
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/editor_width"/>
                <Spinner android:id="@+id/editorWidth" android:layout_width="match_parent"
                    android:layout_height="48dp" android:contentDescription="@string/editor_width"/>
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/editor_height"/>
                <Spinner android:id="@+id/editorHeight" android:layout_width="match_parent"
                    android:layout_height="48dp" android:contentDescription="@string/editor_height"/>
            </LinearLayout>
        </LinearLayout>
        <Button android:id="@+id/editorApply" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/editor_apply"/>
        <Button android:id="@+id/editorReset" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/editor_reset"/>
    </LinearLayout>
</ScrollView>
