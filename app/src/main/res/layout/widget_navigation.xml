<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cardNav"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_weight="1"
    android:background="@drawable/bg_card"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="@dimen/tile_padding">

    <ImageView
        android:id="@+id/iconNav"
        android:layout_width="@dimen/dashboard_quick_icon"
        android:layout_height="@dimen/dashboard_quick_icon"
        android:background="@drawable/bg_widget_icon"
        android:padding="@dimen/dashboard_icon_padding"
        android:contentDescription="@null"
        android:src="@drawable/ic_navigation" />

    <TextView
        android:id="@+id/titleNav"
        style="@style/Text.Gauge"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:ellipsize="end"
        android:gravity="center"
        android:text="@string/card_navigation"
        android:fontFamily="sans-serif-medium"
        android:textSize="@dimen/card_label_text" />

    <TextView
        android:id="@+id/subtitleNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:gravity="center"
        android:layout_marginTop="4dp"
        android:maxLines="2"
        android:text="@string/card_not_set"
        android:textColor="@color/cockpit_text_dim"
        android:textSize="@dimen/card_sub_text" />
</LinearLayout>
