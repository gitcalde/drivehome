<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cardMusic"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_weight="1"
    android:background="@drawable/bg_card"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="@dimen/tile_padding">

    <ImageView
        android:id="@+id/iconMusic"
        android:layout_width="@dimen/card_icon"
        android:layout_height="@dimen/card_icon"
        android:contentDescription="@null"
        android:src="@drawable/ic_music" />

    <TextView
        android:id="@+id/titleMusic"
        style="@style/Text.Gauge"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:gravity="center"
        android:text="@string/card_music"
        android:textSize="@dimen/card_label_text" />

    <TextView
        android:id="@+id/subtitleMusic"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:gravity="center"
        android:singleLine="true"
        android:text="@string/card_not_set"
        android:textColor="@color/cockpit_text_dim"
        android:textSize="@dimen/card_sub_text" />
</LinearLayout>
