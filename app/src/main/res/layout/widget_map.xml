<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mapPortal"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_card"
    android:clipToOutline="true">

    <com.minimal.carlauncher.ui.view.CompassBezelView
        android:id="@+id/compassBezel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/mapClip"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/cockpit_surface_alt">

        <org.osmdroid.views.MapView
            android:id="@+id/mapView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Heading readout. Tap toggles heading-up / north-up. -->
        <LinearLayout
            android:id="@+id/headingChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="@dimen/map_hud_inset"
            android:background="@drawable/bg_hud"
            android:clickable="true"
            android:contentDescription="@string/map_orientation_toggle"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="4dp"
            android:paddingEnd="16dp"
            android:paddingBottom="4dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:baselineAligned="true"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/textCardinal"
                    style="@style/Text.Gauge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/speed_placeholder"
                    android:textSize="@dimen/cardinal_text"
                    tools:text="NE" />

                <TextView
                    android:id="@+id/textDegrees"
                    style="@style/Text.Gauge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textColor="@color/cockpit_text_secondary"
                    android:textSize="@dimen/degrees_text"
                    tools:text="43°" />

                <TextView
                    android:id="@+id/textHeadingSource"
                    style="@style/Text.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/heading" />
            </LinearLayout>

            <TextView
                android:id="@+id/textMapMode"
                style="@style/Text.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/map_mode_heading" />
        </LinearLayout>

        <!-- Map controls, centered vertically. -->
        <ImageButton
            android:id="@+id/btnMapSearch"
            android:layout_width="@dimen/map_button_size"
            android:layout_height="@dimen/map_button_size"
            android:layout_gravity="start|center_vertical"
            android:layout_marginStart="@dimen/map_hud_inset"
            android:background="@drawable/bg_map_button"
            android:contentDescription="@string/map_search_title"
            android:padding="14dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_search" />

        <ImageButton
            android:id="@+id/btnRecenter"
            android:layout_width="@dimen/map_button_size"
            android:layout_height="@dimen/map_button_size"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="@dimen/map_hud_inset"
            android:background="@drawable/bg_map_button"
            android:contentDescription="@string/map_recenter"
            android:padding="14dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_my_location" />

        <!-- [4] Speed HUD. Tap toggles KM/H <-> MPH. -->
        <LinearLayout
            android:id="@+id/gaugeSpeed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="@dimen/map_hud_inset"
            android:background="@drawable/bg_hud"
            android:clickable="true"
            android:contentDescription="@string/speed"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="6dp"
            android:paddingEnd="20dp"
            android:paddingBottom="8dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:baselineAligned="true"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/textSpeed"
                    style="@style/Text.Gauge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:text="@string/speed_placeholder"
                    android:textColor="@color/cockpit_speed"
                    android:textSize="@dimen/speed_text"
                    tools:text="62" />

                <TextView
                    android:id="@+id/textSpeedUnit"
                    style="@style/Text.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="@string/unit_kmh"
                    android:textColor="@color/cockpit_text_secondary"
                    android:textSize="@dimen/speed_unit_text" />
            </LinearLayout>

            <!-- Live GPS lock indicator. -->
            <TextView
                android:id="@+id/textSpeedStatus"
                style="@style/Text.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/gps_acquiring" />
        </LinearLayout>
    </FrameLayout>

    <!-- Place / navigation card. Above the map and its controls. Place mode: name + Navigate. Navigation mode: next manoeuvre,
         distance to it, trip summary + End. -->
    <LinearLayout
        android:id="@+id/mapCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginStart="@dimen/map_card_side_margin"
        android:layout_marginTop="@dimen/map_hud_inset"
        android:layout_marginEnd="@dimen/map_card_side_margin"
        android:background="@drawable/bg_map_card"
        android:clickable="true"
        android:elevation="6dp"
        android:focusable="true"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/cardGlyph"
                style="@style/Text.Gauge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:textColor="@color/cockpit_accent"
                android:textSize="@dimen/nav_glyph_text"
                android:visibility="gone"
                tools:text="→"
                tools:visibility="visible" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/cardTitle"
                    style="@style/Text.Gauge"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:textSize="@dimen/nav_title_text"
                    tools:text="350 m" />

                <TextView
                    android:id="@+id/cardSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textColor="@color/cockpit_text_secondary"
                    android:textSize="@dimen/nav_subtitle_text"
                    tools:text="Turn right onto Meir" />

                <TextView
                    android:id="@+id/cardSummary"
                    style="@style/Text.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:visibility="gone"
                    tools:text="12.4 km · 18 min · 14:32"
                    tools:visibility="visible" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="end"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCardSecondary"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/nav_button_height"
                android:text="@string/map_clear_pin" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCardPrimary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:minHeight="@dimen/nav_button_height"
                android:text="@string/map_navigate"
                app:icon="@drawable/ic_navigation"
                app:iconTint="?attr/colorOnPrimary" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
