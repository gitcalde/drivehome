<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/systemDock"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dock_height"
    android:background="@drawable/bg_dock"
    android:baselineAligned="false"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="4dp"
    android:paddingEnd="4dp">

    <ImageButton
        android:id="@+id/btnTheme"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="@drawable/bg_dock_item"
        android:contentDescription="@string/dock_theme"
        android:padding="14dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_theme" />

    <ImageButton
        android:id="@+id/btnSettings"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="@drawable/bg_dock_item"
        android:contentDescription="@string/dock_settings"
        android:padding="14dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_settings" />

    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">

        <ImageButton
            android:id="@+id/btnAbout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_dock_item"
            android:contentDescription="@string/dock_updates"
            android:padding="14dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_update" />

        <View
            android:id="@+id/updateBadge"
            android:layout_width="@dimen/badge_size"
            android:layout_height="@dimen/badge_size"
            android:layout_gravity="top|end"
            android:layout_marginTop="14dp"
            android:layout_marginEnd="14dp"
            android:background="@drawable/badge_dot"
            android:contentDescription="@string/update_available_badge"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
